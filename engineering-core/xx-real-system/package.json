{
  "name": "payment-infrastructure-lab",
  "version": "1.0.0",
  "private": true,
  "description": "A deterministic, production-inspired payment infrastructure simulator",
  "type": "module",
  "scripts": {
    "dev": "node --watch backend/src/server.js",
    "start": "node backend/src/server.js",
    "test": "vitest run",
    "test:integration": "RUN_INTEGRATION=true vitest run backend/tests/integration.test.js",
    "test:watch": "vitest",
    "check": "node --check backend/src/server.js && node --check frontend/app.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "prom-client": "^15.1.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "supertest": "^7.0.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  }
}
